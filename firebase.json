{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "README.md", "tools/**", "dist/**", ".github/**", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(js|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  }
}
